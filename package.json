{
  "name": "cap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:electron-scripts": "esbuild electron/main.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist-electron/preload.cjs",
    "dev:electron": "npm run build:electron-scripts && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build:app": "npm run build && npm run build:electron-scripts",
    "package:mac": "npm run build:app && electron-builder --mac",
    "package:win": "npm run build:app && electron-builder --win",
    "package:all": "npm run build:app && electron-builder -mw"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@pilio/gemini-watermark-remover": "^1.0.28",
    "@websr/websr": "^0.0.16",
    "@xenova/transformers": "^2.17.2",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.21.0",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.4.1",
    "onnxruntime-web": "^1.27.0",
    "opencv-js-wasm": "^5.0.0-alpha",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "wait-on": "^9.5.1"
  }
}
